{
  "name": "teralexi-ai",
  "version": "0.0.6",
  "description": "Teralexi CLI — local-first AI agent (headless companion to the Teralexi desktop app)",
  "license": "Apache-2.0",
  "author": "Naughty-Otters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naughty-Otters/Teralexi.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.teralexi.com/",
  "bugs": {
    "url": "https://github.com/Naughty-Otters/Teralexi/issues"
  },
  "keywords": [
    "teralexi",
    "ai",
    "agent",
    "cli",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "teralexi": "./bin/teralexi"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
